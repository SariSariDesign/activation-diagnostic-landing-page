# Analytics IDs — copy this file to .env.local and fill in.
# Also set these in Vercel → Project → Settings → Environment Variables
# (Production + Preview). Leave blank to disable analytics (e.g. local dev).

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
# Get it from: GA4 Admin → Data Streams → your web stream.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity Project ID, e.g. abcdefghij (10-char string)
# Get it from: clarity.microsoft.com → your project → Settings → Overview.
NEXT_PUBLIC_CLARITY_ID=

# --- Free Activation Scorecard lead magnet ---------------------------------
# Server-side only (no NEXT_PUBLIC_ prefix). Set in Vercel → Settings → Env Vars.

# Attio CRM API key — leads (person + company + note) are upserted on submit.
# Attio → Settings → Developers → API keys. Leave blank locally to skip CRM writes.
ATTIO_API_KEY=

# --- Phase 2 (background analysis + email delivery) — not yet wired up ------
# FireCrawl (scrape + screenshot the submitted URL): https://firecrawl.dev
FIRECRAWL_API_KEY=
# Anthropic (Claude) — generates the structured scorecard from the page.
ANTHROPIC_API_KEY=
# Optional: override the analysis model without a redeploy. Defaults to
# claude-sonnet-5. Other options: claude-opus-4-8 (sharpest, ~2x cost),
# claude-haiku-4-5 (cheapest — drop thinking/effort in analyze.ts if you switch).
SCORECARD_MODEL=
# Resend — emails the personalized scorecard. Requires a verified sending domain.
RESEND_API_KEY=
# Upstash QStash — triggers the background analysis job with retries.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
